# Keep the UkraineAlarm token on the server, never in firmware or Git.
UKRAINEALARM_API_TOKEN=
HOST=0.0.0.0
PORT=3000
POLL_INTERVAL_MS=30000
REQUEST_TIMEOUT_MS=10000
STALE_AFTER_MS=90000

# Empty MQTT_URL disables MQTT (HTTP-only mode).
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=alarmmini-server
MQTT_TOPIC_LEGACY=ukraine/alarm/map/full
MQTT_TOPIC_V2=ukraine/alarm/map/full_v2
MQTT_TOPIC_STATUS=ukraine/alarm/map/status

# Local web panel credentials. No built-in username or password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional LAN hostnames, e.g. alarmmini.local (LAN IPs work automatically).
ADMIN_ALLOWED_HOSTS=

# Separate tokens. Both support Authorization: Bearer and ?token=...
# Missing token disables its public endpoint; empty NEVER means open access.
PUBLIC_STATUS_TOKEN=
WEBHOOK_TOKEN=
# Initial HTTPS origin. Can instead be saved in the local panel.
PUBLIC_BASE_URL=
SETTINGS_FILE=runtime/settings.json

# Normally leave empty: the panel downloads and persists the verification key
# before webhook registration. Set a path only for a manually managed key.
WEBHOOK_PUBLIC_KEY_FILE=

# Optional initial DuckDNS settings. Disabled until explicitly enabled.
# The local DuckDNS tab saves overrides in runtime/duckdns.json (mode 0600).
DUCKDNS_ENABLED=false
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
DUCKDNS_INTERVAL_MINUTES=5
# Empty: detect this server's public IPv4 through https://api.ipify.org.
# Set an explicit public IPv4 if the MQTT broker is on a different network.
DUCKDNS_IPV4=

# Docker port exposure: host IP is configurable, never tied to a LAN address.
HTTP_BIND=0.0.0.0
HTTP_PORT=3000
